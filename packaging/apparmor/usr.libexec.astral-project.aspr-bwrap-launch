#include <tunables/global>

abi <abi/4.0>,

profile aspr-bwrap-setup /usr/libexec/astral-project/aspr-bwrap-launch flags=(attach_disconnected) {
  # Administrator-approved roots are rendered by render-apparmor-roots.
  #include if exists <local/astral-project-source-roots>
  audit userns,
  audit capability sys_admin,
  audit capability net_admin,
  audit capability setpcap,
  network netlink raw,
  network unix,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  unix,
  unix (create, connect, send, receive, getattr, getopt, setopt) type=stream,

  mount options=(rw rbind) -> /newroot/{,**},
  mount options=(rw rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount fstype=devpts options=(rw nosuid noexec) devpts -> /newroot/dev/pts/,
  mount fstype=proc options=(rw nosuid nodev noexec) proc -> /newroot/@{PROC}/,
  mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /newroot/{,**},
  audit mount fstype=tmpfs options=(rw nosuid nodev) tmpfs -> /tmp/,
  mount options=(rw silent make-rslave) /,
  mount options=(rw silent make-rprivate) /oldroot/,
  remount /newroot/{,**},
  umount /,
  umount /oldroot/,
  mount -> /newroot/{,**},
  pivot_root oldroot=/newroot/ /newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,

  /usr/libexec/astral-project/aspr-bwrap-launch mr,
  /usr/bin/bwrap ix,
  /usr/libexec/astral-project/aspr-sandbox-entry Px -> aspr-bwrap-setup//&aspr-sandbox-payload,
  /usr/** rix,
  /bin/** rix,
  /lib/** mr,
  /lib64/** mr,
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/** r,
  owner / r,
  owner /newroot/{,**} w,
  owner /tmp/newroot/ w,
  owner /tmp/oldroot/ w,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/setgroups rw,
  owner @{PROC}/@{pid}/uid_map rw,
  owner @{PROC}/@{pid}/gid_map rw,
  /run/astral-project/ rw,
  /run/astral-project/session.sock rw,
  unix (create, bind, listen, accept, connect, send, receive, getattr, getopt, setopt),
  @{PROC}/sys/kernel/overflowuid r,
  @{PROC}/sys/kernel/overflowgid r,
  @{PROC}/sys/user/max_user_namespaces r,
  /proc/** r,
  owner /run/user/*/astral-project/** rw,
  /home/** rw,
  /tmp/** rw,
  /tmp/aspr-host-rx.exec* mrix,
  /dev/** rw,
  /run/astral-project/session.sock rw,

  signal,
}

profile aspr-sandbox-payload flags=(attach_disconnected) {
  # Payload has ordinary file/network access only within bwrap's root.
  network unix,
  /usr/** rix,
  /bin/** rix,
  /lib/** mr,
  /lib64/** mr,
  /home/** rw,
  /tmp/** rw,
  /dev/** rw,
  /proc/** r,
  /proc/self/status r,
  /proc/self/attr/current r,
  /run/astral-project/ rw,
  /run/astral-project/session.sock rw,
  /tmp/aspr-host-rx.allow r,
  /tmp/aspr-host-rx.exec* mrix,
  unix (create, bind, listen, accept, connect, send, receive, getattr, getopt, setopt),
  /proc/net/route r,
  /proc/net/dev r,
  /proc/net/if_inet6 r,
  /proc/self/net/** r,
  /run/astral-project/session.sock rw,
  unix (create, connect, send, receive, getattr, getopt, setopt),
  unix (create, connect, send, receive, getattr, getopt, setopt) type=stream,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  signal,
}
