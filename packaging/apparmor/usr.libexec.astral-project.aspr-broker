#include <tunables/global>

abi <abi/4.0>,

profile aspr-broker /usr/libexec/astral-project/aspr-broker flags=(attach_disconnected) {
  #include <abstractions/base>
  capability chown,
  capability dac_override,
  capability fowner,
  capability kill,
  capability setgid,
  capability setuid,
  capability setpcap,
  capability sys_admin,

  /usr/libexec/astral-project/aspr-broker rix,
  /usr/libexec/astral-project/aspr-namespace-worker rix,
  /usr/libexec/astral-project/aspr-mount-worker Px -> aspr-namespace-setup,
  /usr/bin/python3* rix,
  /usr/lib/** r,
  /etc/astral-project/** r,
  /var/lib/astral-project/runtime/** r,
  #include if exists <local/astral-project-source-roots>
  /run/astral-project/** rw,
  /proc/*/{uid_map,gid_map,setgroups} rw,
  /proc/** r,
  unix (accept, getattr, receive, send) type=stream,
  signal (send) set=(kill) peer=aspr-sftp-v1,
  signal (send) set=(kill) peer=aspr-namespace-setup,
  deny network inet,
}

profile aspr-namespace-setup /usr/libexec/astral-project/aspr-mount-worker flags=(attach_disconnected) {
  #include <abstractions/base>
  capability dac_override,
  capability dac_read_search,
  capability setgid,
  capability setuid,
  capability setpcap,
  capability sys_admin,
  /usr/libexec/astral-project/aspr-mount-worker rix,
  /var/lib/astral-project/runtime/** r,
  /run/astral-project/** rw,
  /proc/thread-self/attr/current w,
  /proc/*/attr/current w,
  /proc/*/task/*/attr/current w,
  change_profile -> aspr-sftp-v1,
  userns create,
  signal (receive) set=(kill) peer=aspr-broker,
  pivot_root oldroot=/run/astral-project/staging/**/oldroot/ /run/astral-project/staging/**/,
  umount /oldroot/,
  /oldroot/ w,
  mount options=(rw,rprivate) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /run/astral-project/staging/**,
  # Detached mount-FD sources have no pathname; all targets remain staging-bound.
  mount -> /run/astral-project/staging/**,
  deny network,
}

profile aspr-sftp-v1 flags=(attach_disconnected) {
  # The final workload has explicit file rules below; no base abstraction,
  # because its ambient Unix/network grants would defeat deny semantics.
  /usr/libexec/astral-project/aspr-mount-worker rix,
  /dev/null rw,
  /dev/zero rw,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  # Preserve the Packet 15 final-workload Unix boundary; socket creation and
  # data transfer remain denied by the global rule below.
  unix (getattr, getopt, setopt, shutdown),
  /.astral-project-runtime/ld.so rixm,
  /.astral-project-runtime/sftp-server rixm,
  /.astral-project-runtime/lib/** mr,
  /.astral-project-runtime/etc/** r,
  # AppArmor names detached clone files by their verified backing closure.
  /var/lib/astral-project/runtime/sftp_v1/*/ld.so rixm,
  /var/lib/astral-project/runtime/sftp_v1/*/sftp-server rixm,
  /var/lib/astral-project/runtime/sftp_v1/*/lib/** mr,
  /var/lib/astral-project/runtime/sftp_v1/*/etc/** r,
  /** r,
  /** mr,
  signal (receive) set=(kill) peer=aspr-broker,
  deny userns,
  deny network,
  deny network inet,
  deny unix,
  deny capability,
  deny mount,
  deny /proc/** rwklx,
}
