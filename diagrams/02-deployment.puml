@startuml
title Astral Project — Deployment and Trust Boundaries
skinparam shadowing false

legend right
  |= Color |= Status |
  |<#DDF2DD> | Implemented |
  |<#FFF2CC> | Partial or integration pending |
  |<#E7E7E7> | Target architecture; not implemented |
endlegend

node "Local Linux host" as Local {
  node "Trusted user domain" as Trusted {
    artifact "/usr/bin/python3\n-I + installed application package" as LocalRuntime #FFF2CC
    component "asprd\nstatus/liveness only" as Daemon #FFF2CC
    database "XDG SQLite state" as State #FFF2CC
    component "rclone + aspr-transport" as LocalRemote #E7E7E7
    component "aspr-homed" as Homed #E7E7E7
  }
  node "Local bubblewrap sandbox — target" as Sandbox #E7E7E7 {
    component "Agent harness" as Agent
    folder "Projected HOME" as Projected
    folder "Declared projects +\npre-mounted remote views" as Mounts
    component "Grant-bound session socket" as SessionSocket
  }
}

cloud "OpenSSH" as Net #FFF2CC

node "Enrolled remote Linux host" as Remote {
  node "Enrolled remote-user domain" as UserDomain {
    component "sshd restricted key +\nforced command" as SSHD #DDF2DD
    component "aspr-server" as Server #DDF2DD
    component "stdio / Unix socketpair\nSFTP bridge" as Bridge #DDF2DD
  }

  node "Root-owned broker domain" as RootDomain {
    component "/run/astral-project/broker.sock\nsystemd activation, mode 0660" as BrokerSocket #DDF2DD
    component "aspr-broker\nSO_PEERCRED + authority validation" as Broker #DDF2DD
    database "Root-owned issuer keys +\nper-root ceiling" as Policy #DDF2DD
    component "Descriptor resolver" as Resolver #DDF2DD
    artifact "Sealed ExecutionPlanV1 memfd" as Plan #DDF2DD
    artifact "Verified sftp_v1\nruntime closure" as Runtime #DDF2DD
    component "Native mount worker" as Worker #DDF2DD
    component "Expiry and worker\nreaping registry" as Registry #DDF2DD
  }

  node "Synthetic SFTP namespace" as RemoteSandbox #DDF2DD {
    component "AppArmor profile\naspr-sftp-v1" as AppArmor
    component "Fixed loader + sftp-server" as SFTP
    folder "/.astral-project-runtime" as RuntimeMount
    folder "Planned export targets" as Exports
  }
  folder "Configured source roots" as Sources #DDF2DD
}

LocalRuntime -- Daemon
Daemon -- State
Daemon .. LocalRemote
Daemon .. Homed
Homed .. Projected
LocalRemote .. Mounts
Agent .. Projected
Agent .. Mounts
Agent .. SessionSocket

Daemon ..> Net : target OpenSSH client
Net --> SSHD
SSHD --> Server : exact aspr-channel-v1
Server --> Bridge
Bridge --> BrokerSocket : CBOR request + SCM_RIGHTS\nstream descriptor
BrokerSocket --> Broker
Broker --> Policy
Broker --> Resolver
Sources --> Resolver : opened beneath ceiling roots
Resolver --> Plan : pinned descriptors only
Plan --> Worker : FD 5; source FDs 10–73
Runtime --> Worker : verified directory FD 74
Bridge --> Worker : SFTP stream FD 6
Broker --> Worker : fixed launch; map target UID/GID
Worker --> RuntimeMount : read-only attachment
Worker --> Exports : detached descriptor mounts
Worker --> AppArmor : fixed exec transition
AppArmor --> SFTP
Broker --> Registry : expiry and worker supervision

note right of Worker
The worker creates user and mount namespaces,
marks propagation private, builds a tmpfs staging root,
pivots into it, drops capabilities, sets no_new_privs,
and executes one fixed workload. It does not use bubblewrap.
end note
@enduml
