@startuml
skinparam backgroundColor white
title Astral Project — Packet 15 Remote Session
skinparam shadowing false

participant "rclone" as RC
participant "aspr-transport" as T
participant "asprd" as D
participant "OpenSSH" as SSH
participant "aspr-server" as RS
participant "root-owned broker" as B
participant "target-user DAC resolver" as DAC
participant "pinned descriptors + sealed plan" as Plan
participant "mapped namespace/mount worker" as W
participant "private synthetic root" as Root
participant "fixed confined sftp_v1" as SF
database "Granted objects" as FS

RC -> T : exec external SSH command: -s sftp
T -> T : reject host, user, options, forwarding,\nor non-SFTP command
T -> D : OpenSftpStream(environment-bound capability)
D -> D : authorize session; load signed grant
D -> SSH : exact command aspr-channel-v1
SSH -> RS : restricted key starts forced command
D -> RS : bounded preface + signed grant
RS -> B : broker request
B -> B : SO_PEERCRED authentication
B -> B : independent grant and server-ceiling validation
B -> DAC : resolve sources under target-user DAC
DAC -> Plan : pin source descriptors and identities
B -> Plan : seal bounded internal execution plan
Plan -> W : inherited descriptors + sealed plan
W -> W : mapped namespace and mount construction
W -> Root : build private synthetic root
Root -> W : attach verified fixed runtime
W -> W : remove setup authority; fixed transition
W -> SF : exec confined OpenSSH sftp-server
RS --> D : ready response
D --> T : connected byte stream
T --> RC : transparent SFTP stream

loop Until expiry, revocation, cancellation, or failure
  RC -> SF : SFTP request
  SF -> FS : kernel-enforced granted operation
  FS --> SF : data/status
  SF --> RC : SFTP response
end

B -> W : terminate and reap supervised worker
@enduml
